<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="674a0a21-5da6-445c-96e7-038c569c5b09">
	<property name="ireport.zoom" value="1.9487171000000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tgl_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tgl_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_jenis_lr" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT *
FROM (
    SELECT
        t.tanggal_transaksi AS tanggal,
        'Laba' AS jenis_lr,
        'Layanan' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_layanan AS deskripsi,
        t.total_pembayaran AS total
    FROM transaksi_layanan t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
      AND t.status_pembayaran = 'Lunas'

    UNION ALL

    SELECT
        t.tanggal_transaksi AS tanggal,
        'Laba' AS jenis_lr,
        'Penjualan Produk' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_produk AS deskripsi,
        t.total_harga AS total
    FROM transaksi_penjualan_produk t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}

    UNION ALL

    SELECT
        t.tanggal_transaksi AS tanggal,
        'Rugi' AS jenis_lr,
        'Pembelian Produk' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_produk AS deskripsi,
        t.total_harga AS total
    FROM transaksi_pembelian_produk t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
) x
WHERE
    ($P{p_jenis_lr} = 'Semua')
    OR ($P{p_jenis_lr} = x.jenis_lr)
ORDER BY x.tanggal, x.jenis_lr, x.kategori]]>
	</queryString>
	<field name="tanggal" class="java.sql.Date"/>
	<field name="jenis_lr" class="java.lang.String"/>
	<field name="kategori" class="java.lang.String"/>
	<field name="kode" class="java.lang.String"/>
	<field name="deskripsi" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="totalLaba" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_lr}.equals("Laba") ? $F{total} : new java.math.BigDecimal(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="totalRugi" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_lr}.equals("Rugi") ? $F{total} : new java.math.BigDecimal(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="labaBersih" class="java.math.BigDecimal" calculation="System">
		<variableExpression><![CDATA[$V{totalLaba}.subtract($V{totalRugi})]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
