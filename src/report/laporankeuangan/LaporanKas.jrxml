<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f205f19d-bd6d-4ce8-bc50-66750b696ad0">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tgl_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tgl_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_jenis_kas" class="java.lang.String"/>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT *
FROM (
    -- KAS MASUK: Transaksi Layanan
    SELECT
        t.tanggal_transaksi AS tanggal,
        'Kas Masuk' AS jenis_kas,
        'Layanan' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_layanan AS deskripsi,
        t.total_pembayaran AS jumlah
    FROM transaksi_layanan t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
      AND t.status_pembayaran = 'Lunas'

    UNION ALL

    -- KAS MASUK: Penjualan Produk
    SELECT
        t.tanggal_transaksi AS tanggal,
        'Kas Masuk' AS jenis_kas,
        'Penjualan Produk' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_produk AS deskripsi,
        t.total_harga AS jumlah
    FROM transaksi_penjualan_produk t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}

    UNION ALL

    -- KAS KELUAR: Pembelian Produk
    SELECT
        t.tanggal_transaksi AS tanggal,
        'Kas Keluar' AS jenis_kas,
        'Pembelian Produk' AS kategori,
        t.kode_transaksi AS kode,
        t.nama_produk AS deskripsi,
        t.total_harga AS jumlah
    FROM transaksi_pembelian_produk t
    WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
) x
WHERE
    ($P{p_jenis_kas} = 'Semua')
    OR ($P{p_jenis_kas} = x.jenis_kas)
ORDER BY x.tanggal DESC, x.jenis_kas, x.kategori]]>
	</queryString>
	<field name="tanggal" class="java.sql.Date"/>
	<field name="jenis_kas" class="java.lang.String"/>
	<field name="kategori" class="java.lang.String"/>
	<field name="kode" class="java.lang.String"/>
	<field name="deskripsi" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="jumlah" class="java.math.BigDecimal"/>
	<variable name="v_total_masuk" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_kas}.equals("Kas Masuk") ? $F{jumlah} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="v_total_keluar" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_kas}.equals("Kas Keluar") ? $F{jumlah} : new BigDecimal(0)]]></variableExpression>
	</variable>
