<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="85e11ce5-2660-48b1-a355-81dcb7901b2b">
	<property name="ireport.zoom" value="1.9487171000000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="13"/>
	<parameter name="p_tgl_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tgl_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_membership" class="java.lang.String"/>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    t.kode_pelanggan,
    t.nama_lengkap,
    t.no_telepon,
    p.membership_type,
    COUNT(DISTINCT t.kode_transaksi) as total_kunjungan,
    SUM(t.total_pembayaran) as total_pengeluaran,
    MAX(t.tanggal_transaksi) as kunjungan_terakhir
FROM transaksi_layanan t
LEFT JOIN master_pelanggan p ON t.kode_pelanggan = p.kode_pelanggan
WHERE t.tanggal_transaksi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
  AND t.status_pembayaran = 'Lunas'
  AND (
    ($P{p_membership} = 'Semua')
    OR (p.membership_type = $P{p_membership})
  )
GROUP BY t.kode_pelanggan, t.nama_lengkap, t.no_telepon, p.membership_type
ORDER BY t.nama_lengkap ASC]]>
	</queryString>
	<field name="kode_pelanggan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_lengkap" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="no_telepon" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="membership_type" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_kunjungan" class="java.lang.Long"/>
	<field name="total_pengeluaran" class="java.math.BigDecimal"/>
	<field name="kunjungan_terakhir" class="java.sql.Date"/>
	<variable name="v_total_pelanggan" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{kode_pelanggan}]]></variableExpression>
	</variable>
	<variable name="v_total_pengeluaran" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_pengeluaran}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="v_rata_pengeluaran" class="java.math.BigDecimal" calculation="Average">
		<variableExpression><![CDATA[$F{total_pengeluaran}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
