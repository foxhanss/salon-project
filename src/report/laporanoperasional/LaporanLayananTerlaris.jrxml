<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f3d17dfa-5ac9-4e52-a18c-1dc376d9da63">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="79"/>
	<parameter name="p_ranking" class="java.lang.String">
		<defaultValueExpression><![CDATA[Semua]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    t.kode_layanan,
    t.nama_layanan,
    COALESCE(l.kategori_layanan, '-') as kategori_layanan,
    COUNT(t.kode_transaksi) as total_pembelian,
    SUM(t.total_pembayaran) as total_pendapatan,
    AVG(t.harga_layanan) as rata_harga
FROM transaksi_layanan t
LEFT JOIN master_layanan l ON t.kode_layanan = l.kode_layanan
WHERE t.status_pembayaran = 'Lunas'
  AND (
    ($P{p_ranking} = 'Hari Ini' AND DATE(t.tanggal_transaksi) = CURDATE())
    OR ($P{p_ranking} = 'Minggu Ini' AND YEARWEEK(t.tanggal_transaksi, 1) = YEARWEEK(CURDATE(), 1))
    OR ($P{p_ranking} = 'Bulan Ini' AND MONTH(t.tanggal_transaksi) = MONTH(CURDATE()) AND YEAR(t.tanggal_transaksi) = YEAR(CURDATE()))
    OR ($P{p_ranking} = 'Tahun Ini' AND YEAR(t.tanggal_transaksi) = YEAR(CURDATE()))
    OR ($P{p_ranking} = 'Semua')
  )
GROUP BY t.kode_layanan, t.nama_layanan, l.kategori_layanan
ORDER BY total_pembelian DESC, total_pendapatan DESC]]>
	</queryString>
	<field name="kode_layanan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_layanan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="kategori_layanan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_pembelian" class="java.lang.Long"/>
	<field name="total_pendapatan" class="java.math.BigDecimal"/>
	<field name="rata_harga" class="java.math.BigDecimal"/>
	<variable name="v_total_layanan" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{kode_layanan}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="v_total_pendapatan" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_pendapatan}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="v_nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{kode_layanan}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
