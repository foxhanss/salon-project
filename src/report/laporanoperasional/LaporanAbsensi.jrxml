<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1dc72701-8a7f-4404-9cca-e881fb1782be">
	<property name="ireport.zoom" value="1.3310000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tgl_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tgl_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_jabatan" class="java.lang.String"/>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    a.id_absensi,
    a.kode_absensi,
    a.tanggal_absensi,
    a.nama_karyawan,
    k.jabatan,
    a.jam_masuk,
    a.jam_keluar,
    a.total_jam_kerja,
    a.status_kehadiran,
    COALESCE(a.keterangan, '-') as keterangan
FROM absensi a
INNER JOIN master_karyawan k ON a.kode_karyawan = k.kode_karyawan
WHERE a.tanggal_absensi BETWEEN $P{p_tgl_mulai} AND $P{p_tgl_sampai}
  AND (
    ($P{p_jabatan} = 'Semua Jabatan')
    OR (k.jabatan = $P{p_jabatan})
  )
ORDER BY a.tanggal_absensi DESC, a.nama_karyawan ASC]]>
	</queryString>
