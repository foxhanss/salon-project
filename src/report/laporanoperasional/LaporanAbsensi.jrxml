	</field>
	<variable name="v_total_hadir" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[($F{status_kehadiran}.equals("Hadir") ? 1 : 0)]]></variableExpression>
	</variable>
	<variable name="v_total_sakit" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{status_kehadiran}.equals("Sakit") ? 1 : 0)]]></variableExpression>
	</variable>
	<variable name="v_total_izin" class="java.lang.Integer" calculation="Sum">
