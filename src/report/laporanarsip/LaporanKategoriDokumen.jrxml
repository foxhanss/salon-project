	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_status_dokumen" class="java.lang.String"/>
	<parameter name="p_urutan" class="java.lang.String"/>
	<parameter name="p_summary_aktif" class="java.lang.String"/>
	<parameter name="p_summary_nonaktif" class="java.lang.String"/>
	<parameter name="p_summary_expired" class="java.lang.String"/>
