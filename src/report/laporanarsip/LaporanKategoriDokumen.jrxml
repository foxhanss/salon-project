	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    a.kategori_dokumen,
    COUNT(*) as jumlah,
    GROUP_CONCAT(DISTINCT a.status ORDER BY a.status SEPARATOR ', ') as status
FROM arsip_dokumen a
WHERE a.status != 'Deleted'
  AND ($P{p_tanggal_mulai} IS NULL OR DATE(a.tanggal_dokumen) >= $P{p_tanggal_mulai})
  AND ($P{p_tanggal_sampai} IS NULL OR DATE(a.tanggal_dokumen) <= $P{p_tanggal_sampai})
  AND (
      $P{p_status_dokumen} IS NULL 
      OR $P{p_status_dokumen} = 'Semua Status' 
      OR a.status = $P{p_status_dokumen}
  )
GROUP BY a.kategori_dokumen
ORDER BY jumlah DESC, a.kategori_dokumen ASC]]>
	</queryString>
	<field name="kategori_dokumen" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="jumlah" class="java.lang.Long"/>
	<field name="status" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
