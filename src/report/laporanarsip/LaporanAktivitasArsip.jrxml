<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="af3a1004-4710-40f2-808b-349248d8b36a">
	<property name="ireport.zoom" value="1.7715610000000017"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_jenis_aktivitas" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["Semua Aktivitas"]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="p_summary_upload" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_summary_akses" class="java.lang.String"/>
	<parameter name="p_summary_edit" class="java.lang.String"/>
	<parameter name="p_summary_delete" class="java.lang.String"/>
	<parameter name="p_summary_total" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    a.id_dokumen,
    a.log_timestamp as tanggal,
    a.judul_dokumen as nama_dokumen,
    a.kategori_dokumen,
    CASE 
        WHEN a.log_aktivitas = 'Tambah' THEN 'Upload'
        WHEN a.log_aktivitas = 'Hapus' THEN 'Delete'
        ELSE a.log_aktivitas
    END as jenis_aktivitas,
    COALESCE(a.log_user, 'System') as log_user,
    CONCAT(
        CASE 
            WHEN a.log_aktivitas = 'Tambah' THEN 'Dokumen ditambahkan'
            WHEN a.log_aktivitas = 'Edit' THEN 'Dokumen diedit'
            WHEN a.log_aktivitas = 'Hapus' THEN 'Dokumen dihapus'
            ELSE 'Aktivitas dokumen'
        END,
        ' oleh ',
        COALESCE(a.log_user, 'System'),
        ' | Kategori: ',
        COALESCE(a.kategori_dokumen, 'N/A'),
        ' | Status: ',
        a.status
    ) as log_ringkas
FROM arsip_dokumen a
WHERE a.status != 'Deleted'
  AND ($P{p_tanggal_mulai} IS NULL OR DATE(a.log_timestamp) >= $P{p_tanggal_mulai})
  AND ($P{p_tanggal_sampai} IS NULL OR DATE(a.log_timestamp) <= $P{p_tanggal_sampai})
  AND (
      $P{p_jenis_aktivitas} IS NULL 
      OR $P{p_jenis_aktivitas} = 'Semua Aktivitas' 
      OR (a.log_aktivitas = 'Tambah' AND $P{p_jenis_aktivitas} = 'Upload')
      OR (a.log_aktivitas = 'Edit' AND $P{p_jenis_aktivitas} = 'Edit')
      OR (a.log_aktivitas = 'Hapus' AND $P{p_jenis_aktivitas} = 'Delete')
  )
ORDER BY a.log_timestamp DESC]]>
	</queryString>
	<field name="id_dokumen" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="nama_dokumen" class="java.lang.String"/>
	<field name="kategori_dokumen" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="jenis_aktivitas" class="java.lang.String"/>
	<field name="log_user" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="log_ringkas" class="java.lang.String"/>
	<variable name="v_count_tambah" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_aktivitas}.equals("Tambah") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="v_count_edit" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_aktivitas}.equals("Edit") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="v_count_hapus" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jenis_aktivitas}.equals("Hapus") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="v_count_akses" class="java.lang.String"/>
