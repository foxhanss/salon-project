		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_membership" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_jenis_kelamin" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua Jenis Kelamin"]]></defaultValueExpression>
	</parameter>
