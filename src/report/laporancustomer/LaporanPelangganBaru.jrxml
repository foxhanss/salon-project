		<variableExpression><![CDATA[$F{membership_type}.equals("Regular") ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_count_silver" class="java.lang.String" calculation="Sum">
