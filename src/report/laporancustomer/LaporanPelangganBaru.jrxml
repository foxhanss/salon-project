	<queryString>
		<![CDATA[SELECT 
    kode_pelanggan,
    nama_lengkap,
    no_telepon,
    email,
    membership_type,
    jenis_kelamin,
    tanggal_registrasi
FROM master_pelanggan
WHERE status = 'Aktif'
  AND ($P{p_tanggal_mulai} IS NULL OR tanggal_registrasi >= $P{p_tanggal_mulai})
  AND ($P{p_tanggal_sampai} IS NULL OR tanggal_registrasi <= $P{p_tanggal_sampai})
  AND ($P{p_membership} = 'Semua' OR membership_type = $P{p_membership})
  AND ($P{p_jenis_kelamin} = 'Semua Jenis Kelamin' OR jenis_kelamin = $P{p_jenis_kelamin})
ORDER BY tanggal_registrasi DESC]]>
	</queryString>
