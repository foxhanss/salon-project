	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_summary_total_pelanggan" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="p_summary_total_belanja" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    p.kode_pelanggan,
    p.nama_lengkap,
    p.no_telepon,
    p.email,
    p.membership_type,
    p.tanggal_registrasi,
    COALESCE(
        (SELECT SUM(tl.total_pembayaran)
         FROM transaksi_layanan tl
         WHERE tl.kode_pelanggan = p.kode_pelanggan
           AND tl.status_pembayaran = 'Lunas'
           AND ($P{p_tanggal_mulai} IS NULL OR tl.tanggal_transaksi >= $P{p_tanggal_mulai})
           AND ($P{p_tanggal_sampai} IS NULL OR tl.tanggal_transaksi <= $P{p_tanggal_sampai})
        ), 0
    ) as total_belanja
FROM master_pelanggan p
WHERE p.status = 'Aktif'
HAVING total_belanja > 0
ORDER BY total_belanja DESC]]>
	</queryString>
