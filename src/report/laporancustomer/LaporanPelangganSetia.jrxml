		<initialValueExpression><![CDATA[new java.lang.Integer(1)]]></initialValueExpression>
	</variable>
	<variable name="v_total_belanja_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_belanja}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
