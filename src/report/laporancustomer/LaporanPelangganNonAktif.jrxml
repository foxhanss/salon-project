<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0cdf192b-31ee-4d7b-ab02-060817f826b3">
	<property name="ireport.zoom" value="1.3310000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_summary_total" class="java.lang.String"/>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    p.kode_pelanggan,
    p.nama_lengkap,
    p.no_telepon,
    p.membership_type,
    p.tanggal_registrasi,
    p.deleted_at as tanggal_nonaktif,
    p.deleted_by as dinonaktifkan_oleh,
    COALESCE(p.catatan_khusus, '-') as alasan
FROM master_pelanggan p
WHERE p.status = 'Non-Aktif'
  AND p.deleted_at IS NOT NULL
  AND DATE(p.deleted_at) >= $P{p_tanggal_mulai}
  AND DATE(p.deleted_at) <= $P{p_tanggal_sampai}
ORDER BY p.deleted_at DESC]]>
	</queryString>
