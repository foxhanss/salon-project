	</field>
	<field name="telepon_supplier" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="count_kritis" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status}.equals("Habis") || $F{status}.equals("Kritis") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="count_warning" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status}.equals("Warning") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="count_aman" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{status}.equals("Aman") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="total_produk" class="java.lang.Integer" calculation="Count"/>
	<variable name="v_nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
