<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c5e13411-bf67-4898-b1fa-d7edee8b1493">
	<property name="ireport.zoom" value="1.6105100000000028"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="14"/>
	<parameter name="p_kategori" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua Kategori"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_alert_level" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_supplier" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua Supplier"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_urut" class="java.lang.String">
		<defaultValueExpression><![CDATA["Kritis → Aman"]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
  p.kode_produk,
  p.nama_produk,
  p.kategori_produk,
  p.stok_saat_ini,
  p.stok_minimum,
  CASE 
    WHEN p.stok_saat_ini = 0 THEN 'Habis'
    WHEN p.stok_saat_ini < p.stok_minimum THEN 'Kritis'
    WHEN p.stok_saat_ini = p.stok_minimum THEN 'Warning'
    ELSE 'Aman'
  END as status,
  GREATEST(0, p.stok_minimum - p.stok_saat_ini) as jumlah_restock,
  COALESCE(p.nama_supplier, '-') as nama_supplier,
  COALESCE(p.telepon_supplier, '-') as telepon_supplier
FROM master_produk p
WHERE p.status = 'Aktif'
  AND (
    $P{p_kategori} = 'Semua Kategori' 
    OR p.kategori_produk = $P{p_kategori}
  )
  AND (
    $P{p_alert_level} = 'Semua'
    OR (
      $P{p_alert_level} = 'Kritis' 
      AND (p.stok_saat_ini = 0 OR p.stok_saat_ini < p.stok_minimum)
    )
    OR (
      $P{p_alert_level} = 'Warning' 
      AND p.stok_saat_ini = p.stok_minimum
    )
    OR (
      $P{p_alert_level} = 'Aman' 
      AND p.stok_saat_ini > p.stok_minimum
    )
  )
  AND (
    $P{p_supplier} = 'Semua Supplier' 
    OR p.nama_supplier = $P{p_supplier}
  )
ORDER BY 
  CASE $P{p_urut}
    WHEN 'Kritis → Aman' THEN 
      CASE 
        WHEN p.stok_saat_ini = 0 THEN 1
        WHEN p.stok_saat_ini < p.stok_minimum THEN 2
        WHEN p.stok_saat_ini = p.stok_minimum THEN 3
        ELSE 4 
      END
    WHEN 'Nama' THEN 0
    WHEN 'Stok' THEN p.stok_saat_ini
  END ASC,
  p.nama_produk ASC]]>
	</queryString>
