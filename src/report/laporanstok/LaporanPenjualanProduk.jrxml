<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="85a74720-a9cd-4197-b700-38f7d6dcd0c8">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="95"/>
	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<parameterDescription><![CDATA[Tanggal mulai periode penjualan]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<parameterDescription><![CDATA[Tanggal akhir periode penjualan]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_kategori" class="java.lang.String">
		<parameterDescription><![CDATA[Filter kategori produk]]></parameterDescription>
		<defaultValueExpression><![CDATA["Semua Kategori"]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    p.kode_produk,
    p.nama_produk,
    p.kategori_produk,
    SUM(tp.jumlah_jual) as jumlah_terjual,
    SUM(tp.total_harga) as total_pendapatan,
    SUM(tp.jumlah_jual * (tp.harga_satuan - COALESCE(p.harga_beli, 0))) as profit,
    (SELECT COUNT(DISTINCT p_inner.kode_produk) 
     FROM transaksi_penjualan_produk tp_inner
     INNER JOIN master_produk p_inner ON tp_inner.kode_produk = p_inner.kode_produk
     WHERE tp_inner.tanggal_transaksi >= $P{p_tanggal_mulai}
       AND tp_inner.tanggal_transaksi <= DATE_ADD($P{p_tanggal_sampai}, INTERVAL 1 DAY)
       AND (IFNULL($P{p_kategori}, 'Semua Kategori') = 'Semua Kategori' 
            OR p_inner.kategori_produk = $P{p_kategori})
    ) as total_produk,
    (SELECT COALESCE(SUM(tp_inner.jumlah_jual), 0) 
     FROM transaksi_penjualan_produk tp_inner
     INNER JOIN master_produk p_inner ON tp_inner.kode_produk = p_inner.kode_produk
     WHERE tp_inner.tanggal_transaksi >= $P{p_tanggal_mulai}
       AND tp_inner.tanggal_transaksi <= DATE_ADD($P{p_tanggal_sampai}, INTERVAL 1 DAY)
       AND (IFNULL($P{p_kategori}, 'Semua Kategori') = 'Semua Kategori' 
            OR p_inner.kategori_produk = $P{p_kategori})
    ) as grand_total_terjual,
    (SELECT COALESCE(SUM(tp_inner.total_harga), 0) 
     FROM transaksi_penjualan_produk tp_inner
     INNER JOIN master_produk p_inner ON tp_inner.kode_produk = p_inner.kode_produk
     WHERE tp_inner.tanggal_transaksi >= $P{p_tanggal_mulai}
       AND tp_inner.tanggal_transaksi <= DATE_ADD($P{p_tanggal_sampai}, INTERVAL 1 DAY)
       AND (IFNULL($P{p_kategori}, 'Semua Kategori') = 'Semua Kategori' 
            OR p_inner.kategori_produk = $P{p_kategori})
    ) as grand_total_pendapatan,
    (SELECT COALESCE(SUM(tp_inner.jumlah_jual * (tp_inner.harga_satuan - COALESCE(p_inner.harga_beli, 0))), 0) 
     FROM transaksi_penjualan_produk tp_inner
     INNER JOIN master_produk p_inner ON tp_inner.kode_produk = p_inner.kode_produk
     WHERE tp_inner.tanggal_transaksi >= $P{p_tanggal_mulai}
       AND tp_inner.tanggal_transaksi <= DATE_ADD($P{p_tanggal_sampai}, INTERVAL 1 DAY)
       AND (IFNULL($P{p_kategori}, 'Semua Kategori') = 'Semua Kategori' 
            OR p_inner.kategori_produk = $P{p_kategori})
    ) as grand_total_profit
FROM transaksi_penjualan_produk tp
INNER JOIN master_produk p ON tp.kode_produk = p.kode_produk
WHERE tp.tanggal_transaksi >= $P{p_tanggal_mulai}
  AND tp.tanggal_transaksi <= DATE_ADD($P{p_tanggal_sampai}, INTERVAL 1 DAY)
  AND (IFNULL($P{p_kategori}, 'Semua Kategori') = 'Semua Kategori' 
       OR p.kategori_produk = $P{p_kategori})
GROUP BY p.kode_produk, p.nama_produk, p.kategori_produk
ORDER BY jumlah_terjual DESC, total_pendapatan DESC]]>
	</queryString>
