	<field name="jumlah_terjual" class="java.math.BigDecimal"/>
	<field name="total_pendapatan" class="java.math.BigDecimal"/>
	<field name="profit" class="java.math.BigDecimal"/>
	<field name="total_produk" class="java.lang.Long"/>
	<field name="grand_total_terjual" class="java.math.BigDecimal"/>
	<field name="grand_total_pendapatan" class="java.math.BigDecimal"/>
	<field name="grand_total_profit" class="java.math.BigDecimal"/>
	<variable name="v_nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
