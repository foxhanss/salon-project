	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="10"/>
	<property name="ireport.y" value="113"/>
	<parameter name="p_tanggal_mulai" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_tanggal_sampai" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_supplier" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="namaUser" class="java.lang.String"/>
	<parameter name="roleUser" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
  tp.kode_transaksi,
  DATE_FORMAT(tp.tanggal_transaksi, '%d/%m/%Y') as tanggal,
  tp.nama_supplier,
  tp.nama_produk,
  tp.jumlah_beli,
  tp.harga_satuan,
  tp.total_harga,
  tp.metode_pembayaran
FROM transaksi_pembelian_produk tp
WHERE DATE(tp.tanggal_transaksi) >= DATE($P{p_tanggal_mulai})
  AND DATE(tp.tanggal_transaksi) <= DATE($P{p_tanggal_sampai})
  AND (
    $P{p_supplier} = 'Semua' 
    OR tp.nama_supplier = $P{p_supplier}
  )
ORDER BY tp.tanggal_transaksi DESC, tp.kode_transaksi DESC]]>
	</queryString>
	<field name="kode_transaksi" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tanggal" class="java.lang.String"/>
	<field name="nama_supplier" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_produk" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="jumlah_beli" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="harga_satuan" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_harga" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="metode_pembayaran" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="v_nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="total_transaksi" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{kode_transaksi}]]></variableExpression>
	</variable>
	<variable name="total_item" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{jumlah_beli}]]></variableExpression>
	</variable>
	<variable name="total_pembelian" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_harga}]]></variableExpression>
	</variable>
