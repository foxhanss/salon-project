		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_produk" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="kategori_produk" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="stok_saat_ini" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="stok_minimum" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="status_stok" class="java.lang.String"/>
	<field name="harga_jual" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nilai_inventori" class="java.math.BigDecimal"/>
	<variable name="v_nomor" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_total_produk" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_total_aman" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{status_stok} != null && $F{status_stok}.equals("Aman")) ? new java.lang.Integer(1) : new java.lang.Integer(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_total_menipis" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{status_stok} != null && $F{status_stok}.equals("Menipis")) ? new java.lang.Integer(1) : new java.lang.Integer(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_total_habis" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[($F{status_stok} != null && $F{status_stok}.equals("Habis")) ? new java.lang.Integer(1) : new java.lang.Integer(0)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="v_total_nilai" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_inventori}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
